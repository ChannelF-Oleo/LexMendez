# =============================================================================
# LexMendez Global — Variables de entorno (plantilla)
# Copia este archivo a .env.local y rellena los valores. NO subas .env.local.
# =============================================================================

# --- Firebase (cliente / público) ---------------------------------------------
# Expuestas al navegador (prefijo NEXT_PUBLIC_). Tomadas de la consola de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=              # apiKey del proyecto Firebase
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=          # p.ej. lexmendez.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=           # id del proyecto Firebase
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=       # p.ej. lexmendez.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=  # messagingSenderId
NEXT_PUBLIC_FIREBASE_APP_ID=               # appId

# --- Firebase Admin (servidor) -------------------------------------------------
# Solo servidor. Se define en fases posteriores (panel admin / operaciones seguras).
FIREBASE_ADMIN_PROJECT_ID=                 # id del proyecto (service account)
FIREBASE_ADMIN_CLIENT_EMAIL=               # client_email de la service account
FIREBASE_ADMIN_PRIVATE_KEY=                # private_key (con \n escapados)

# --- Resend (email transaccional) ----------------------------------------------
RESEND_API_KEY=                            # API key de Resend
CONTACT_TO_EMAIL=info@lexmendezglobal.com  # destinatario del formulario de contacto
CONTACT_FROM_EMAIL=onboarding@resend.dev   # remitente verificado en Resend
