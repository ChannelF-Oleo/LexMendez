rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Posts del blog.
    match /posts/{postId} {
      // Lectura: pública si el post está publicado; los usuarios autenticados
      // (futuro panel admin) también pueden leer borradores.
      allow read: if resource.data.status == 'published'
                  || request.auth != null;

      // Escritura: solo usuarios autenticados. En la Fase 5 se restringirá
      // además por rol/uid de administrador.
      allow write: if request.auth != null;
    }

    // Denegar por defecto todo lo demás.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
