rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin único por UID. DEBE coincidir con ADMIN_UIDS en .env.local.
    // (Firestore rules no leen variables de entorno; el uid va hardcodeado.)
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'uNSTTiIsePOWkJ3kWPYPARF57Zp2';
    }

    // Posts del blog.
    match /posts/{postId} {
      // Lectura: pública si el post está publicado; el admin también puede leer
      // borradores (para el panel).
      allow read: if resource.data.status == 'published' || isAdmin();

      // Escritura: solo el admin.
      allow write: if isAdmin();
    }

    // Denegar por defecto todo lo demás.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
