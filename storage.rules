rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Admin único por UID. DEBE coincidir con ADMIN_UIDS en .env.local.
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'uNSTTiIsePOWkJ3kWPYPARF57Zp2';
    }

    // Portadas de posts del blog.
    match /posts/{allPaths=**} {
      // Lectura pública: las portadas se muestran en el sitio.
      allow read: if true;
      // Escritura: solo el admin.
      allow write: if isAdmin();
    }

    // Denegar por defecto todo lo demás.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
