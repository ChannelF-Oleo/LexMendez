rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Portadas de posts del blog.
    match /posts/{allPaths=**} {
      // Lectura pública: las portadas se muestran en el sitio.
      allow read: if true;
      // Escritura: solo usuarios autenticados (futuro panel admin).
      allow write: if request.auth != null;
    }

    // Denegar por defecto todo lo demás.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
